{
  "version": 2,
  "builds": [
    {
      "src": "api/serverless.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/serverless.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/sweep",
      "schedule": "0 0 * * *" 
    },
    {
      "path": "/api/cron/retention",
      "schedule": "0 1 * * *"
    }
  ]
}
