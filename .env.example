# ============ ROSE & DENIM — environment ============
# Copy to .env in the repo root AND in apps/api/.
# The API runs in simulator mode by default — no external keys needed for local dev.

# --- Run mode: set to "real" to use live services (requires keys below) ---
PAYSTACK_MODE=sim            # sim | real
WHATSAPP_MODE=sim            # sim | real
IMAGES_MODE=sim              # sim | cloudinary

# --- API server ---
PORT=4000
JWT_SECRET=change-me-in-production
DATABASE_URL="postgresql://user:password@localhost:5432/rosedenim_dev"

# --- CORS: comma-separated origins allowed to call the API ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- WhatsApp business number (used for wa.me deep links) ---
WHATSAPP_NUMBER=233200000000

# --- Paystack (required when PAYSTACK_MODE=real) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:4000/webhooks/paystack

# --- Meta WhatsApp Cloud API (required when WHATSAPP_MODE=real) ---
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=rose-denim-verify
META_APP_SECRET=              # Required for webhook signature verification in real mode

# --- Cloudinary (required when IMAGES_MODE=cloudinary) ---
CLOUDINARY_URL=

# --- Redis (optional; falls back to in-memory TTL store) ---
REDIS_URL=

# --- Seed owner account ---
OWNER_EMAIL=kukua@roseanddenim.com
OWNER_PASSWORD=denim-rose-2026

# --- Frontends (client-side) ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Frontends (server-side, used by Next.js SSR in the web app) ---
API_URL=http://localhost:4000
